<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="495" height="200" viewBox="0 0 495 200" aria-label="GitHub 统计卡片">
    <title>octocat 的 GitHub 统计</title>
    <rect width="495" height="200" rx="8" ry="8" fill="#1e1e1e" stroke="#30363d" stroke-width="1"></rect>
    <circle cx="23" cy="36.4" r="3" fill="#1f2328"></circle>
    <text x="32" y="42" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="16" font-weight="600" fill="#c9d1d9">GitHub</text>
    <text x="20" y="62" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="11" font-weight="400" fill="#8b949e">开源仓库与影响力</text>
    <text x="475" y="42" font-family="inherit" font-size="11" fill="#8b949e" text-anchor="end">@octocat</text>
    <line x1="20" y1="76" x2="475" y2="76" stroke="#30363d" stroke-width="1"></line>
    <text x="20" y="124" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="18" font-weight="600" fill="#c9d1d9">8</text>
    <text x="20" y="142" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="11" font-weight="400" fill="#8b949e">仓库</text>
    <text x="133.75" y="124" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="18" font-weight="600" fill="#c9d1d9">23k</text>
    <text x="133.75" y="142" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="11" font-weight="400" fill="#8b949e">星标</text>
    <text x="247.5" y="124" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="18" font-weight="600" fill="#c9d1d9">25k</text>
    <text x="247.5" y="142" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="11" font-weight="400" fill="#8b949e">关注者</text>
    <text x="361.25" y="124" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="18" font-weight="600" fill="#c9d1d9">2.8k</text>
    <text x="361.25" y="142" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="11" font-weight="400" fill="#8b949e">均值星标</text>
    <line x1="20" y1="160" x2="475" y2="160" stroke="#30363d" stroke-width="1"></line>
    <text x="20" y="186" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="10" font-weight="400" fill="#8b949e">GitHub Profile Statistics</text>
    <text x="475" y="186" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Noto Sans SC,PingFang SC,Microsoft YaHei,Helvetica,Arial,sans-serif" font-size="10" font-weight="400" fill="#8b949e" text-anchor="end">更新于 2026-11-21</text>
  </svg>